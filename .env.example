# ── Backend Configuration ──────────────────────────────────────────
# Pexels API Key for stock image fetching
PEXELS_API_KEY=your_pexels_api_key_here

# Portal Authentication
CINEMA_USER=admin
CINEMA_PASSWORD=cinemaforge

# Storage Paths (relative to app root or absolute)
CINEMA_DB_PATH=data/cinemaforge.db
ASSETS_FOLDER=assets
OUTPUT_FOLDER=output_cinema
VOICES_FOLDER=voices
MUSIC_FOLDER=music
SFX_FOLDER=sfx

# YouTube Configuration
YT_CLIENT_SECRET=client_secret.json
YT_TOKEN_FILE=data/yt_token.json
YT_CATEGORY_ID=22
YT_PRIVACY=public

# ── Frontend Configuration ─────────────────────────────────────────
# Base URL for the backend API (used by Vite)
VITE_API_BASE=http://localhost:8001
